# 默认是完全离线的界面演示，不调用任何模型服务。
COMPANION_LLM_PROVIDER=demo
NEXT_TELEMETRY_DISABLED=1

# 使用本机 Ollama 时：
# COMPANION_LLM_PROVIDER=ollama
# COMPANION_LLM_BASE_URL=http://127.0.0.1:11434
# COMPANION_LLM_MODEL=qwen3:8b

# 使用 OpenAI 兼容接口时：
# COMPANION_LLM_PROVIDER=openai-compatible
# COMPANION_LLM_BASE_URL=https://example.com
# COMPANION_LLM_MODEL=your-model
# COMPANION_LLM_API_KEY=replace-with-your-server-side-key

# 使用硅基流动作为文字回复模型时（不会用于语音识别）：
# COMPANION_LLM_PROVIDER=openai-compatible
# COMPANION_LLM_BASE_URL=https://api.siliconflow.cn
# COMPANION_LLM_MODEL=Qwen/Qwen3.6-27B
# COMPANION_LLM_API_KEY=replace-with-your-server-side-key
# 心理陪伴回复会显式关闭推理输出，避免思考 token 挤占正文。

# 本地语音默认读取项目 models/ 下随产品安装的 sherpa-onnx 模型。
# 只有移动模型目录时才需要设置：
# COMPANION_ASR_MODEL_DIR=/absolute/path/to/sherpa-model

# 高拟真回答语音默认复用硅基流动密钥，只发送模型生成的回答文字，
# 不会上传麦克风录音。可单独配置密钥，也可复用 COMPANION_LLM_API_KEY：
# COMPANION_TTS_PROVIDER=siliconflow
# COMPANION_TTS_BASE_URL=https://api.siliconflow.cn
# COMPANION_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# COMPANION_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna
# COMPANION_TTS_SPEED=0.96
# COMPANION_TTS_API_KEY=replace-with-your-server-side-key
#
# 网络不可用时，macOS 使用较柔和的 Shelley 作为本机兜底：
# COMPANION_TTS_SYSTEM_VOICE=Shelley (中文（中国大陆）)

# 默认从当前项目的 skill/psychological-companion 读取内置规则。
# 只有移动目录结构后才需要设置：
# COMPANION_SKILL_ROOT=/path/to/psychological-companion
